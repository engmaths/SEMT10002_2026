        "def selection_sort(numbers):\n",
        "    \"\"\"\n",
        "    Sorts a list of values in ascending order in-place\n",
        "    \"\"\"\n",
        "\n",
        "    for i in range(len(numbers)):\n",
        "\n",
        "        '''\n",
        "        Initialise the index of the miniumum unsorted value as \n",
        "        the current position in the list\n",
        "        '''\n",
        "        min_index = i\n",
        "\n",
        "        ''' \n",
        "        Update this index with the index of the smallest value \n",
        "        to the right of the current position\n",
        "        '''\n",
        "        for j in range(i + 1, len(numbers)):\n",
        "            if numbers[j] < numbers[min_index]:  # COMPARISON\n",
        "                min_index = j\n",
        "        \n",
        "        '''\n",
        "        Swap the smallest value to the right of the current position \n",
        "        with the value at the current position\n",
        "        '''\n",
        "        numbers[i], numbers[min_index] = numbers[min_index], numbers[i]\n",
        "\n",
        "numbers = [1,2,5,7,2,5,6]\n",
        "selection_sort(numbers)\n",
        "print(numbers)"
      ]
